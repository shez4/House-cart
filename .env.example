# Copy this to `.env` (which is gitignored) and fill in what you want.
# Every value is optional — the app runs fine with none of them set.

# Enables "Sign in with Google". Create an OAuth 2.0 Client ID (Web application)
# in the Google Cloud Console and paste the Client ID here. Requires the app to
# be served over HTTPS at a URL you register as an authorized JavaScript origin.
# Leave blank to use the simple no-password name-picker instead.
GOOGLE_CLIENT_ID=

# Enables receipt auto-scanning with Claude's vision model.
# Without it, receipts still upload and you type the line items in by hand.
ANTHROPIC_API_KEY=

# Currency symbol shown when a receipt doesn't specify one.
# Leave blank for "$" (New Zealand dollar). Or set e.g. NZ$ or NZD.
HOUSECART_CURRENCY=

# Vision model used to read receipts. Haiku 4.5 is fast and cheap;
# set to claude-opus-4-8 for maximum accuracy.
HOUSECART_PARSE_MODEL=claude-haiku-4-5
