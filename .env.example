# Copy this to `.env` (which is gitignored) and fill in what you need.

# REQUIRED — Postgres connection string.
# On Vercel: create a Postgres store in the dashboard (Storage → Create) and
# this is injected automatically as POSTGRES_URL — you don't set it by hand.
# Locally: e.g. postgres://postgres:password@127.0.0.1:5432/housecart
POSTGRES_URL=

# Stores receipt photos on Vercel Blob. On Vercel: create a Blob store in the
# dashboard and BLOB_READ_WRITE_TOKEN is injected automatically.
# Without it, receipts still work — they just have no photo attached.
BLOB_READ_WRITE_TOKEN=

# Enables "Sign in with Google". Create an OAuth 2.0 Client ID (Web application)
# in the Google Cloud Console and add your deployed HTTPS URL as an authorized
# JavaScript origin. Leave blank to use the simple no-password name-picker.
GOOGLE_CLIENT_ID=

# Enables receipt auto-scanning with Claude's vision model (optional).
# Without it, receipts still upload and you type the line items in by hand.
ANTHROPIC_API_KEY=

# Currency symbol shown when a receipt doesn't specify one.
# Leave blank for "$" (New Zealand dollar). Or set e.g. NZ$ or NZD.
HOUSECART_CURRENCY=

# Vision model used to read receipts (only used if ANTHROPIC_API_KEY is set).
HOUSECART_PARSE_MODEL=claude-haiku-4-5
